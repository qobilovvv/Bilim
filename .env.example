# Copy to .env, fill credentials, and generate the JWT secret with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=production
POSTGRES_DB=bilim
POSTGRES_USER=bilim
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+asyncpg://bilim:replace-with-a-strong-database-password@postgres-db:5432/bilim
JWT_SECRET_KEY=
CORS_ORIGINS=["https://your-frontend.example"]
APP_HOST_PORT=8000
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
MEDIA_ROOT=media
# Set to the exact reverse proxy source IP visible to the container.
# Do not use * on an internet-accessible deployment.
TRUSTED_PROXY_IPS=127.0.0.1
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
